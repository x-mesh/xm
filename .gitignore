# Runtime data (created per-project, not part of plugin)
.xm/
**/.xm/
.x-build/
.tm-build/
.omc/
.codex/

# x-build runtime (legacy — should no longer appear here)
x-build/lib/projects/
x-build/lib/metrics/

# Node
node_modules/

# Coverage / test artifacts (ephemeral V8 output — regenerated by `bun test`)
coverage/

# Local settings
.claude/settings.local.json

# Local skill installs (personal, not part of this repo)
.claude/skills/impeccable/

# Multi-tool install OUTPUT, not source. `xm/lib/install/transform/*.mjs` generates
# these from x-*/skills/*/SKILL.md at install time (frontmatter, skill naming, and
# path rewrites differ per target). They were committed as a by-product of running
# the installer against this repo and drifted from source — .opencode/ sat 3 months
# stale. The generator is the single source of truth; test/install*.test.mjs covers it.
.opencode/
.agents/
plugins/xm/

# Local impeccable state (per-machine critique output, hook cache)
.impeccable/

# Local session state (codex consult session ids, etc. — per-machine, not shared)
.context/

# OS
.DS_Store
Thumbs.db
.gstack/

# Prototypes — LLM outputs (large, noisy); keep scripts/rubrics/golden
prototypes/*/out/
prototypes/*/out-*/
